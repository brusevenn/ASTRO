None
TMP_0 = CONVERT name to bytes
TMP_1(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_0)
hashedName(bytes32) := TMP_1(bytes32)
TMP_2 = CONVERT version to bytes
TMP_3(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_2)
hashedVersion(bytes32) := TMP_3(bytes32)
TMP_4(bytes32) = SOLIDITY_CALL keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))
typeHash(bytes32) := TMP_4(bytes32)
_HASHED_NAME(bytes32) := hashedName(bytes32)
_HASHED_VERSION(bytes32) := hashedVersion(bytes32)
TMP_5(uint256) = INTERNAL_CALL, EIP712._getChainId()()
EXPRESSION:hashedName = keccak256(bytes)(bytes(name))	NodeType.VARIABLE
hashedName = keccak256(bytes)(bytes(name))	NodeType.EXPRESSION
hashedVersion = keccak256(bytes)(bytes(version))	NodeType.VARIABLE
hashedVersion = keccak256(bytes)(bytes(version))	NodeType.EXPRESSION
typeHash = keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))	NodeType.VARIABLE
typeHash = keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))	NodeType.EXPRESSION
_HASHED_NAME = hashedName	NodeType.EXPRESSION
_HASHED_VERSION = hashedVersion	NodeType.EXPRESSION
_CACHED_CHAIN_ID = _getChainId()	NodeType.EXPRESSION";
"BlockID: 3
Call context: 
None
_CACHED_CHAIN_ID(uint256) := TMP_5(uint256)
TMP_6(bytes32) = INTERNAL_CALL, EIP712._buildDomainSeparator(bytes32,bytes32,bytes32)(typeHash,hashedName,hashedVersion)
EXPRESSION:_CACHED_CHAIN_ID = _getChainId()	NodeType.EXPRESSION
_CACHED_DOMAIN_SEPARATOR = _buildDomainSeparator(typeHash,hashedName,hashedVersion)	NodeType.EXPRESSION" [shape=box];
"BlockID: 4

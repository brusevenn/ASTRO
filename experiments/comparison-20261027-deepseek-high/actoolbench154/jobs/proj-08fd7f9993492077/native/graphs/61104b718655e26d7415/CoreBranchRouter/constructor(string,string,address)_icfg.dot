"BlockID: 1
Call context: 
None
TMP_198(string) = SOLIDITY_CALL string.concat()(Hermes - ,_name)
TMP_199 = CONVERT TMP_198 to string
TMP_200(string) = SOLIDITY_CALL string.concat()(h-,_symbol)
TMP_201 = CONVERT TMP_200 to string
name(string) := _name(string)
symbol(string) := _symbol(string)
decimals(uint8) := _decimals(uint8)
INITIAL_CHAIN_ID(uint256) := block.chainid(uint256)
TMP_88(bytes32) = SOLIDITY_CALL keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))
TMP_89 = CONVERT name to bytes
TMP_90(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_89)
TMP_91(bytes32) = SOLIDITY_CALL keccak256(bytes)(1)
TMP_92 = CONVERT this to address
TMP_93(bytes) = SOLIDITY_CALL abi.encode()(TMP_88,TMP_90,TMP_91,block.chainid,TMP_92)
TMP_94(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_93)
TMP_511(None) := TMP_94(bytes32)
INITIAL_DOMAIN_SEPARATOR(bytes32) := TMP_62(bytes32)
INLINE ASM
TMP_99(address) = newOwner << 96
TMP_100(address) = TMP_99 >> 96
newOwner(address) := TMP_100(address)
TMP_101 = ~ _OWNER_SLOT_NOT 
TMP_102(None) = SOLIDITY_CALL sstore(uint256,uint256)(TMP_101,newOwner)
TMP_103(None) = SOLIDITY_CALL log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)
EXPRESSION:name = _name	NodeType.EXPRESSION
symbol = _symbol	NodeType.EXPRESSION
decimals = _decimals	NodeType.EXPRESSION
INITIAL_CHAIN_ID = block.chainid	NodeType.EXPRESSION
INITIAL_DOMAIN_SEPARATOR = computeDomainSeparator()	NodeType.EXPRESSION
ERC20(string(string.concat(Hermes - ,_name)),string(string.concat(h-,_symbol)),18)	NodeType.EXPRESSION
None	NodeType.ASSEMBLY
newOwner = newOwner << 96 >> 96	NodeType.EXPRESSION
sstore(uint256,uint256)(~ _OWNER_SLOT_NOT,newOwner)	NodeType.EXPRESSION
log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)	NodeType.EXPRESSION";

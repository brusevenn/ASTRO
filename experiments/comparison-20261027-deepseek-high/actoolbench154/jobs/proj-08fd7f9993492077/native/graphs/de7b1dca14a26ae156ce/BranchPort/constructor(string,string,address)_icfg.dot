TMP_621(None) := TMP_242(bytes32)
INITIAL_DOMAIN_SEPARATOR(bytes32) := TMP_210(bytes32)
INLINE ASM
TMP_247(address) = newOwner << 96
TMP_248(address) = TMP_247 >> 96
newOwner(address) := TMP_248(address)
TMP_249 = ~ _OWNER_SLOT_NOT 
TMP_250(None) = SOLIDITY_CALL sstore(uint256,uint256)(TMP_249,newOwner)
TMP_251(None) = SOLIDITY_CALL log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)

None
name(string) := _name(string)
symbol(string) := _symbol(string)
decimals(uint8) := _decimals(uint8)
INITIAL_CHAIN_ID(uint256) := block.chainid(uint256)
TMP_1054(bytes32) = SOLIDITY_CALL keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))
TMP_1055 = CONVERT name to bytes
TMP_1056(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_1055)
TMP_1057(bytes32) = SOLIDITY_CALL keccak256(bytes)(1)
TMP_1058 = CONVERT this to address
TMP_1059(bytes) = SOLIDITY_CALL abi.encode()(TMP_1054,TMP_1056,TMP_1057,block.chainid,TMP_1058)
TMP_1060(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_1059)
TMP_4763(None) := TMP_1060(bytes32)
INITIAL_DOMAIN_SEPARATOR(bytes32) := TMP_1028(bytes32)
INLINE ASM
TMP_3494(address) = newOwner << 96
TMP_3495(address) = TMP_3494 >> 96
newOwner(address) := TMP_3495(address)
TMP_3496 = ~ _OWNER_SLOT_NOT 
TMP_3497(None) = SOLIDITY_CALL sstore(uint256,uint256)(TMP_3496,newOwner)
TMP_3498(None) = SOLIDITY_CALL log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)
bHermes(address) := msg.sender(address)
EXPRESSION:name = _name	NodeType.EXPRESSION
symbol = _symbol	NodeType.EXPRESSION
decimals = _decimals	NodeType.EXPRESSION
INITIAL_CHAIN_ID = block.chainid	NodeType.EXPRESSION
INITIAL_DOMAIN_SEPARATOR = computeDomainSeparator()	NodeType.EXPRESSION
ERC20(bHermes Boost,bHERMES-B,18)	NodeType.EXPRESSION
None	NodeType.ASSEMBLY
newOwner = newOwner << 96 >> 96	NodeType.EXPRESSION
sstore(uint256,uint256)(~ _OWNER_SLOT_NOT,newOwner)	NodeType.EXPRESSION
log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)	NodeType.EXPRESSION
_initializeOwner(_owner)	NodeType.EXPRESSION
bHermes = msg.sender	NodeType.EXPRESSION";

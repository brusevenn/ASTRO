perMilleRemaining = (1000000000000000 / auctionDuration) / (1000000000000 / timeRemaining)	NodeType.EXPRESSION
variableAmount = startPrice - endPrice	NodeType.VARIABLE
variableAmount = startPrice - endPrice	NodeType.EXPRESSION
variableAmountRemaining = (perMilleRemaining * variableAmount) / 1000	NodeType.VARIABLE
variableAmountRemaining = (perMilleRemaining * variableAmount) / 1000	NodeType.EXPRESSION
endPrice + variableAmountRemaining	NodeType.RETURN";

_principal(uint256) := _principalRequested(uint256)
fundsLent_(uint256) := _principal(uint256)
TMP_332(uint256) = INTERNAL_CALL, MapleLoanInternals._getUnaccountedAmount(address)(_fundsAsset)
EXPRESSION:_lender = lender_	NodeType.EXPRESSION
_nextPaymentDueDate = block.timestamp + _paymentInterval	NodeType.EXPRESSION
fundsLent_ = _principal = _principalRequested	NodeType.EXPRESSION
require(bool,string)(_getUnaccountedAmount(_fundsAsset) >= fundsLent_,MLI:FL:WRONG_FUND_AMOUNT)	NodeType.EXPRESSION";

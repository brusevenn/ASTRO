Call context: 
None
TMP_384(uint256) = TMP_381 (c)+ TMP_383
owed(uint256) := TMP_384(uint256)
TMP_385(uint256) = LIBRARY_CALL, dest:FixedPointMathLib, function:FixedPointMathLib.mulDivDown(uint256,uint256,uint256), arguments:['excess', 'owed', '_totalOwed'] 
EXPRESSION:owed = _tranche.principalAmount + _tranche.accruedInterest + _tranche.principalAmount.getInterest(_tranche.aprBps,block.timestamp - _tranche.startTime)	NodeType.VARIABLE

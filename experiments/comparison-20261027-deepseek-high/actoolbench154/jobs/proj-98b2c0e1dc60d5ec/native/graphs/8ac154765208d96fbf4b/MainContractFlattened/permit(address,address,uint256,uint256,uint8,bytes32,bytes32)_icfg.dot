TMP_412 = CONVERT 1 to bytes
TMP_413(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_412)
TMP_414 = CONVERT this to address
TMP_415(bytes) = SOLIDITY_CALL abi.encode()(TMP_408,TMP_411,TMP_413,block.chainid,TMP_414)
TMP_416(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_415)
DOMAIN_SEPARATOR(bytes32) := TMP_416(bytes32)
REF_103(uint256) -> nonces[owner]
TMP_417(uint256) := REF_103(uint256)

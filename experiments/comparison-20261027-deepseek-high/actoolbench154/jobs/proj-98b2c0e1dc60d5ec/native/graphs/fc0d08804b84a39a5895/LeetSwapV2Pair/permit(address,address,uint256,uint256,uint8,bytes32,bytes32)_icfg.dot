Call context: 
None
TMP_401 = CONVERT TMP_400 to bytes
TMP_402(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_401)
TMP_403 = CONVERT 1 to bytes
TMP_404(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_403)
TMP_405 = CONVERT this to address
TMP_406(bytes) = SOLIDITY_CALL abi.encode()(TMP_399,TMP_402,TMP_404,block.chainid,TMP_405)
TMP_407(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_406)
DOMAIN_SEPARATOR(bytes32) := TMP_407(bytes32)
REF_103(uint256) -> nonces[owner]
TMP_408(uint256) := REF_103(uint256)
REF_103(-> nonces) = REF_103 (c)+ 1
TMP_409(bytes) = SOLIDITY_CALL abi.encode()(PERMIT_TYPEHASH,owner,spender,value,TMP_408,deadline)

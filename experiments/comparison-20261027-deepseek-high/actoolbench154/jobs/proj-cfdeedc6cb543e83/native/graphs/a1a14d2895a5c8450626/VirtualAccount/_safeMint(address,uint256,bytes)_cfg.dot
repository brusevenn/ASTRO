"BlockID: 187
Call context: 
None
TMP_302(bytes) = SOLIDITY_CALL code(address)(to)
REF_43 -> LENGTH TMP_302
TMP_303(bool) = REF_43 == 0
TMP_304 = CONVERT to to ERC721TokenReceiver
TMP_305 = CONVERT 0 to address
TMP_306(bytes4) = HIGH_LEVEL_CALL, dest:TMP_304(ERC721TokenReceiver), function:onERC721Received, arguments:['msg.sender', 'TMP_305', 'id', 'data']  
EXPRESSION:_mint(to,id)	NodeType.EXPRESSION
require(bool,string)(to.code.length == 0 || ERC721TokenReceiver(to).onERC721Received(msg.sender,address(0),id,data) == ERC721TokenReceiver.onERC721Received.selector,UNSAFE_RECIPIENT)	NodeType.EXPRESSION";
"BlockID: 189
Call context: 
None
REF_46(bytes4) (->None) := 353073666(uint256)
TMP_307(bool) = TMP_306 == REF_46
TMP_308(bool) = TMP_303 || TMP_307
CONDITION TMP_308
EXPRESSION:TMP_308(bool) = TMP_303 || TMP_307	NodeType.IF";
"BlockID: 190
Call context: 
True
TMP_309(None) = SOLIDITY_CALL revert()()
EXPRESSION:revert()()	NodeType.EXPRESSION";

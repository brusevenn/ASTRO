"BlockID: 356
Call context: 
None
TMP_401(bytes) = SOLIDITY_CALL code(address)(to)
REF_61 -> LENGTH TMP_401
TMP_402(bool) = REF_61 == 0
TMP_403 = CONVERT to to ERC721TokenReceiver
TMP_404 = CONVERT 0 to address
TMP_405(bytes4) = HIGH_LEVEL_CALL, dest:TMP_403(ERC721TokenReceiver), function:onERC721Received, arguments:['msg.sender', 'TMP_404', 'id', 'data']  
EXPRESSION:_mint(to,id)	NodeType.EXPRESSION
require(bool,string)(to.code.length == 0 || ERC721TokenReceiver(to).onERC721Received(msg.sender,address(0),id,data) == ERC721TokenReceiver.onERC721Received.selector,UNSAFE_RECIPIENT)	NodeType.EXPRESSION";
"BlockID: 358
Call context: 
None
REF_64(bytes4) (->None) := 353073666(uint256)
TMP_406(bool) = TMP_405 == REF_64
TMP_407(bool) = TMP_402 || TMP_406
CONDITION TMP_407
EXPRESSION:TMP_407(bool) = TMP_402 || TMP_406	NodeType.IF";
"BlockID: 359

recoveredAddress(address) := TMP_495(address)
TMP_496 = CONVERT 0 to address
TMP_497(bool) = recoveredAddress != TMP_496
TMP_498(bool) = recoveredAddress == owner
TMP_499(bool) = TMP_497 && TMP_498
CONDITION TMP_499
EXPRESSION:TMP_499(bool) = TMP_497 && TMP_498	NodeType.IF";

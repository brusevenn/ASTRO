TMP_421(None) = SOLIDITY_CALL log3(uint256,uint256,uint256,uint256,uint256)(0,0,_OWNERSHIP_TRANSFERRED_EVENT_SIGNATURE,0,newOwner)
EXPRESSION:localChainId = _localChainId	NodeType.EXPRESSION
factoryAddress = _factoryAddress	NodeType.EXPRESSION
None	NodeType.ASSEMBLY

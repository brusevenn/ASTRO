"BlockID: 1
Call context: 
None
TMP_522(string) = SOLIDITY_CALL string.concat()(_name)
TMP_523 = CONVERT TMP_522 to string
TMP_524(string) = SOLIDITY_CALL string.concat()(_symbol)
TMP_525 = CONVERT TMP_524 to string
name(string) := _name(string)
symbol(string) := _symbol(string)
decimals(uint8) := _decimals(uint8)
INITIAL_CHAIN_ID(uint256) := block.chainid(uint256)
TMP_320(bytes32) = SOLIDITY_CALL keccak256(bytes)(EIP712Domain(string name,string version,uint256 chainId,address verifyingContract))
TMP_321 = CONVERT name to bytes
TMP_322(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_321)
TMP_323(bytes32) = SOLIDITY_CALL keccak256(bytes)(1)
TMP_324 = CONVERT this to address
TMP_325(bytes) = SOLIDITY_CALL abi.encode()(TMP_320,TMP_322,TMP_323,block.chainid,TMP_324)
TMP_326(bytes32) = SOLIDITY_CALL keccak256(bytes)(TMP_325)
TMP_872(None) := TMP_326(bytes32)
INITIAL_DOMAIN_SEPARATOR(bytes32) := TMP_294(bytes32)
TMP_515 = CONVERT 0 to address
TMP_516(bool) = _rootPortAddress != TMP_515
CONDITION TMP_516
EXPRESSION:name = _name	NodeType.EXPRESSION
symbol = _symbol	NodeType.EXPRESSION
decimals = _decimals	NodeType.EXPRESSION
INITIAL_CHAIN_ID = block.chainid	NodeType.EXPRESSION
INITIAL_DOMAIN_SEPARATOR = computeDomainSeparator()	NodeType.EXPRESSION
TMP_516(bool) = _rootPortAddress != TMP_515	NodeType.IF";

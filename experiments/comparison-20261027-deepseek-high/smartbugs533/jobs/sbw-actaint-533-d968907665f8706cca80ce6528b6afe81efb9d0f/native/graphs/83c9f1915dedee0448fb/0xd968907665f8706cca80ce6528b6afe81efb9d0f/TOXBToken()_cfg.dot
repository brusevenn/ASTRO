"BlockID: 260
Call context: 
None
TMP_123 = CONVERT decimals to uint256
TMP_124(uint256) = 10 ** TMP_123
TMP_125(uint256) = 1000000000 * TMP_124
totalSupply(uint256) := TMP_125(uint256)
TMP_126 = CONVERT decimals to uint256
TMP_127(uint256) = 10 ** TMP_126
TMP_128(uint256) = 400000000 * TMP_127
frozenForever(uint256) := TMP_128(uint256)
REF_80(uint256) -> balances[msg.sender]
TMP_129(uint256) = INTERNAL_CALL, SafeMath.subSafe(uint256,uint256)(totalSupply,frozenForever)
EXPRESSION:totalSupply = 1000000000 * 10 ** uint256(decimals)	NodeType.EXPRESSION
frozenForever = 400000000 * 10 ** uint256(decimals)	NodeType.EXPRESSION
balances[msg.sender] = subSafe(totalSupply,frozenForever)	NodeType.EXPRESSION";
"BlockID: 261
Call context: 
None
REF_80(uint256) (->balances) := TMP_129(uint256)
owner(address) := msg.sender(address)
EXPRESSION:balances[msg.sender] = subSafe(totalSupply,frozenForever)	NodeType.EXPRESSION
owner = msg.sender	NodeType.EXPRESSION" [shape=box];

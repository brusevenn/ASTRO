lockedInviteProfits(uint128) = lockedInviteProfits + TMP_46
TMP_47(uint128) = lockedInBets + lockedInviteProfits
TMP_48 = CONVERT this to address
TMP_49(uint256) = SOLIDITY_CALL balance(address)(TMP_48)
TMP_50(bool) = TMP_47 <= TMP_49
CONDITION TMP_50
EXPRESSION:TMP_50(bool) = TMP_47 <= TMP_49	NodeType.IF" -> "BlockID: 105
Call context: 
False
END_IF
EXPRESSION:None	NodeType.ENDIF" [key=0];
"BlockID: 105
Call context: 
False
END_IF
EXPRESSION:None	NodeType.ENDIF" -> "BlockID: 78
Call context: 
None
REF_5(uint256) -> bet.amount
REF_5(uint256) (->bet) := amount(uint256)
REF_6(uint8) -> bet.rollUnder
TMP_53 = CONVERT rollUnder to uint8
REF_6(uint8) (->bet) := TMP_53(uint8)
REF_7(uint40) -> bet.placeBlockNumber
TMP_54 = CONVERT block.number to uint40
REF_7(uint40) (->bet) := TMP_54(uint40)
REF_8(address) -> bet.player
REF_8(address) (->bet) := msg.sender(address)
REF_9(bool) -> bet.finished
REF_9(bool) (->bet) := False(bool)
TMP_55(bool) = inviter != croupier
CONDITION TMP_55
EXPRESSION:Commit(commit)	NodeType.EXPRESSION
bet.amount = amount	NodeType.EXPRESSION
bet.rollUnder = uint8(rollUnder)	NodeType.EXPRESSION
bet.placeBlockNumber = uint40(block.number)	NodeType.EXPRESSION
bet.player = msg.sender	NodeType.EXPRESSION
bet.finished = false	NodeType.EXPRESSION
inviter != croupier	NodeType.IF" [key=0];
}

"BlockID: 1
Call context: 
None
REF_16(uint256) -> balanceOfOld[_owner]
TMP_33(uint256) = earningsPerShare * REF_16
TMP_34 = CONVERT TMP_33 to int256
REF_17(int256) -> payouts[_owner]
TMP_35(int256) = TMP_34 - REF_17
TMP_36 = CONVERT TMP_35 to uint256
TMP_37(uint256) = TMP_36 / PRECISION
TMP_181(None) := TMP_37(uint256)
balance(uint256) := TMP_38(uint256)
REF_18(int256) -> payouts[msg.sender]
TMP_39(uint256) = balance * PRECISION
TMP_40 = CONVERT TMP_39 to int256
REF_18(-> payouts) = REF_18 + TMP_40
TMP_41(uint256) = balance * PRECISION
TMP_42 = CONVERT TMP_41 to int256
totalPayouts(int256) = totalPayouts + TMP_42
Transfer dest:to value:balance
EXPRESSION:balance = dividends(msg.sender)	NodeType.VARIABLE
balance = dividends(msg.sender)	NodeType.EXPRESSION
payouts[msg.sender] += int256(balance * PRECISION)	NodeType.EXPRESSION
totalPayouts += int256(balance * PRECISION)	NodeType.EXPRESSION
to.transfer(balance)	NodeType.EXPRESSION";

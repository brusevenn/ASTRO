winningNumber = uint256(randHash) % totalTickets	NodeType.EXPRESSION
winningAddress = contestants[winningNumber].addr	NodeType.VARIABLE
winningAddress = contestants[winningNumber].addr	NodeType.EXPRESSION
raffleId ++	NodeType.EXPRESSION
nextTicket = 0	NodeType.EXPRESSION
winningAddress.transfer(prize)	NodeType.EXPRESSION";

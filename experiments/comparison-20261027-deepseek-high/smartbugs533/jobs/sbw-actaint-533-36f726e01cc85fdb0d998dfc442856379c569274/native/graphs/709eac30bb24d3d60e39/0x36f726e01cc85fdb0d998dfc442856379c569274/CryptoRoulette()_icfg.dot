digraph {
"BlockID: 0
Call context: 
None
ENTRY_POINT
EXPRESSION:None	NodeType.ENTRYPOINT" [shape=box];
"BlockID: 1
Call context: 
None
ownerAddr(address) := msg.sender(address)
TMP_1(uint256) = block.number - 1
TMP_2(uint256) = SOLIDITY_CALL blockhash(uint256)(TMP_1)
TMP_3(bytes32) = SOLIDITY_CALL sha3()(now,TMP_2)
TMP_4 = CONVERT TMP_3 to uint8
TMP_5(uint8) = TMP_4 % 20
TMP_6(uint8) = TMP_5 + 1
secretNumber(uint256) := TMP_6(uint8)
EXPRESSION:ownerAddr = msg.sender	NodeType.EXPRESSION
secretNumber = uint8(sha3()(now,block.blockhash(block.number - 1))) % 20 + 1	NodeType.EXPRESSION";
"BlockID: 0

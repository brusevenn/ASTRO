"BlockID: 1
Call context: 
None
REF_16(uint256) -> balanceOfOld[_owner]
TMP_34(uint256) = earningsPerShare * REF_16
TMP_35 = CONVERT TMP_34 to int256
REF_17(int256) -> payouts[_owner]
TMP_36(int256) = TMP_35 - REF_17
TMP_37 = CONVERT TMP_36 to uint256
TMP_38(uint256) = TMP_37 / PRECISION
TMP_181(None) := TMP_38(uint256)
balance(uint256) := TMP_39(uint256)
REF_18(int256) -> payouts[msg.sender]
TMP_40(uint256) = balance * PRECISION
TMP_41 = CONVERT TMP_40 to int256
REF_18(-> payouts) = REF_18 + TMP_41
TMP_42(uint256) = balance * PRECISION
TMP_43 = CONVERT TMP_42 to int256
totalPayouts(int256) = totalPayouts + TMP_43
Transfer dest:to value:balance
EXPRESSION:balance = dividends(msg.sender)	NodeType.VARIABLE
balance = dividends(msg.sender)	NodeType.EXPRESSION
payouts[msg.sender] += int256(balance * PRECISION)	NodeType.EXPRESSION
totalPayouts += int256(balance * PRECISION)	NodeType.EXPRESSION
to.transfer(balance)	NodeType.EXPRESSION";

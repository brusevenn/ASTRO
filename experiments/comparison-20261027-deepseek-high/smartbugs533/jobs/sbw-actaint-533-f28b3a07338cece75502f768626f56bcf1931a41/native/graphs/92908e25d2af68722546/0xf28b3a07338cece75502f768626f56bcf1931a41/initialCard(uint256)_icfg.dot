TMP_17(bytes32) = SOLIDITY_CALL sha256()(TMP_16)
TMP_18 = CONVERT TMP_17 to uint256
TMP_19(uint256) = TMP_18 % total
TMP_20(uint256) = TMP_19 + 1
i(uint256) := TMP_20(uint256)
EXPRESSION:i = uint256(sha256()(abi.encodePacked(block.timestamp,block.number - i - 1))) % total + 1	NodeType.EXPRESSION";

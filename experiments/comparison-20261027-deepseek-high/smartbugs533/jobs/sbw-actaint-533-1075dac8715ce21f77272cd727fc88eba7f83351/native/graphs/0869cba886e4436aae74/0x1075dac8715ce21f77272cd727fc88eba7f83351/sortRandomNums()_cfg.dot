TMP_28(uint256) = TMP_27 % 6
TMP_29(uint256) = TMP_28 + 1
REF_6(uint256) (->nums) := TMP_29(uint256)
INTERNAL_CALL, SicBo.sort(uint256[])(nums)
EXPRESSION:random = uint256(keccak256()(abi.encodePacked(blockhash(uint256)(block.number - 1),block.difficulty,block.coinbase,now)))	NodeType.VARIABLE
random = uint256(keccak256()(abi.encodePacked(blockhash(uint256)(block.number - 1),block.difficulty,block.coinbase,now)))	NodeType.EXPRESSION
nums = new uint256[](3)	NodeType.VARIABLE
nums = new uint256[](3)	NodeType.EXPRESSION
nums[0] = (random & 0xFFFFFFFFFFFFFFFF) % 6 + 1	NodeType.EXPRESSION
nums[1] = ((random >> 64) & 0xFFFFFFFFFFFFFFFF) % 6 + 1	NodeType.EXPRESSION
nums[2] = (random >> 128) % 6 + 1	NodeType.EXPRESSION
sort(nums)	NodeType.EXPRESSION";
"BlockID: 81

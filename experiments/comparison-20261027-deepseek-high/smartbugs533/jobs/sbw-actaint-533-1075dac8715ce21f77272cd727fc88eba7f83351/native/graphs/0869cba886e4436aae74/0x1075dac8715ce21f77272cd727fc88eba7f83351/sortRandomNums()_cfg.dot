TMP_15(bytes) = SOLIDITY_CALL abi.encodePacked()(TMP_14,block.difficulty,block.coinbase,now)
TMP_16(bytes32) = SOLIDITY_CALL keccak256()(TMP_15)
TMP_17 = CONVERT TMP_16 to uint256
random(uint256) := TMP_17(uint256)
TMP_19uint256[])  = new uint256[](3)
nums(uint256[]) =  ['TMP_19(uint256[])']
REF_4(uint256) -> nums[0]
TMP_20(uint256) = random & 18446744073709551615
TMP_21(uint256) = TMP_20 % 6
TMP_22(uint256) = TMP_21 + 1
REF_4(uint256) (->nums) := TMP_22(uint256)
REF_5(uint256) -> nums[1]
